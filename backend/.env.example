DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

GEMINI_API_KEY=
OPENAQ_API_KEY=

# Prefer this for deployment secret managers. Paste the full service-account JSON on one line.
GEE_SERVICE_ACCOUNT_JSON=

# Alternative for hosts that mount secret files.
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_SERVICE_ACCOUNT_EMAIL=